{
  "minLines": 10,
  "minTokens": 50,
  "maxLines": 500,
  "maxSize": "100kb",
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.cache/**",
    "**/coverage/**",
    "**/package-lock.json"
  ],
  "reporters": ["console"],
  "format": ["javascript", "typescript", "json", "markdown", "bash", "yaml"]
}
